# Copy this file to .env (cp .env.example .env). Never commit .env.
# These values are for local development only. DATABASE_URL matches docker-compose.yml.

DATABASE_URL="postgresql://fabricio:postgres@db:5432/nestdb"

# Secret used to sign the JWTs. Generate a strong one with: openssl rand -base64 32
JWT_SECRET="change-me"

# Admin user created by the seed script when the container starts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
